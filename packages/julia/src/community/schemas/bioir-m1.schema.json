{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PROPOSED M1 bioir-m1.schema.json",
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "address": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/definitions/id"
        },
        "species": {
          "$ref": "#/definitions/id"
        },
        "port": {
          "$ref": "#/definitions/id"
        }
      },
      "required": [
        "owner",
        "species",
        "port"
      ],
      "additionalProperties": false
    },
    "rates": {
      "type": "object",
      "properties": {
        "sender_production": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "molecule/s"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "sender_decay": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "1/s"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "receiver_decay": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "1/s"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "env_decay": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "1/s"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "reporter_decay": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "1/s"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "reporter_basal": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "molecule/s"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "reporter_induced": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "molecule/s"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "threshold": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "const": "molecule/L"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "hill_n": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "unit": {
              "const": "1"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "sender_import": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "1/s"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "sender_export": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "1/s"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "receiver_import": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "1/s"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "receiver_export": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "1/s"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sender_production",
        "sender_decay",
        "receiver_decay",
        "env_decay",
        "reporter_decay",
        "reporter_basal",
        "reporter_induced",
        "threshold",
        "hill_n",
        "sender_import",
        "sender_export",
        "receiver_import",
        "receiver_export"
      ],
      "additionalProperties": false
    },
    "populations": {
      "type": "object",
      "properties": {
        "sender": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "receiver": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sender",
        "receiver"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "sender.signal": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "molecule"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "receiver.signal": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "molecule"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "env.signal": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "molecule"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "receiver.reporter": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "molecule"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sender.signal",
        "receiver.signal",
        "env.signal",
        "receiver.reporter"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "content": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Design"
            },
            "schema_version": {
              "const": "0.2.0"
            },
            "id": {
              "$ref": "#/definitions/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "owners": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/id"
                  },
                  "role": {
                    "enum": [
                      "sender",
                      "receiver",
                      "env"
                    ]
                  },
                  "volume": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "unit": {
                        "const": "L"
                      }
                    },
                    "required": [
                      "value",
                      "unit"
                    ],
                    "additionalProperties": false
                  },
                  "species": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "$ref": "#/definitions/id"
                        },
                        "role": {
                          "enum": [
                            "signal",
                            "reporter"
                          ]
                        },
                        "ports": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "$ref": "#/definitions/id"
                              },
                              "kind": {
                                "enum": [
                                  "transport_out",
                                  "transport_in",
                                  "density_out",
                                  "sensor_in"
                                ]
                              }
                            },
                            "required": [
                              "id",
                              "kind"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "id",
                        "role",
                        "ports"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "role",
                  "volume",
                  "species"
                ],
                "additionalProperties": false
              },
              "minItems": 3,
              "maxItems": 3
            },
            "connections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "$ref": "#/definitions/address"
                  },
                  "target": {
                    "$ref": "#/definitions/address"
                  }
                },
                "required": [
                  "source",
                  "target"
                ],
                "additionalProperties": false
              },
              "minItems": 5,
              "maxItems": 5
            }
          },
          "required": [
            "kind",
            "schema_version",
            "id",
            "revision",
            "owners",
            "connections"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Experiment"
            },
            "schema_version": {
              "const": "0.2.0"
            },
            "id": {
              "$ref": "#/definitions/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "design": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/definitions/id"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                }
              },
              "required": [
                "id",
                "revision",
                "digest"
              ],
              "additionalProperties": false
            },
            "populations": {
              "$ref": "#/definitions/populations"
            },
            "initial_counts": {
              "$ref": "#/definitions/counts"
            },
            "parameters": {
              "$ref": "#/definitions/rates"
            },
            "observables": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/id"
                  },
                  "state": {
                    "enum": [
                      "sender.signal",
                      "receiver.signal",
                      "env.signal",
                      "receiver.reporter"
                    ]
                  }
                },
                "required": [
                  "id",
                  "state"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "schema_version",
            "id",
            "revision",
            "design",
            "populations",
            "initial_counts",
            "parameters",
            "observables"
          ],
          "additionalProperties": false
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "required": [
    "content",
    "digest"
  ],
  "additionalProperties": false
}
