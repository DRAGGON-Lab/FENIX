{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:fenix:proposed:run-manifest:m0:0.1.0",
  "title": "PROPOSED ADR-P07 M0 run-manifest 0.1.0",
  "$comment": "PROPOSED; human-PI ratification pending. Structure only: ADR-P07 additionally requires strict raw decoding, field-specific numeric validation, verified sources and cross-artifact semantic checks.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "RunManifest"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "status": {
      "const": "success"
    },
    "repeatability": {
      "const": "bounded_numerical_agreement"
    },
    "sources": {
      "type": "object",
      "properties": {
        "design": {
          "$ref": "#/definitions/source"
        },
        "experiment": {
          "$ref": "#/definitions/source"
        }
      },
      "required": [
        "design",
        "experiment"
      ],
      "additionalProperties": false
    },
    "fir": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "canonicalization_version": {
          "const": "0.1.0"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "schema_version",
        "canonicalization_version",
        "digest"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "ode"
        },
        "time_grid": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 1
        },
        "method": {
          "enum": [
            "DOP853",
            "Radau"
          ]
        },
        "rtol": {
          "type": "number",
          "minimum": 2.220446049250313e-14
        },
        "atol": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_nfev": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "profile",
        "time_grid",
        "method",
        "rtol",
        "atol",
        "max_step",
        "max_nfev"
      ],
      "additionalProperties": false
    },
    "randomness": {
      "type": "object",
      "properties": {
        "rng": {
          "const": "none"
        },
        "seed": {
          "type": "null"
        }
      },
      "required": [
        "rng",
        "seed"
      ],
      "additionalProperties": false
    },
    "solver": {
      "type": "object",
      "properties": {
        "name": {
          "const": "scipy.integrate.solve_ivp"
        },
        "method": {
          "enum": [
            "DOP853",
            "Radau"
          ]
        },
        "options": {
          "type": "object",
          "properties": {
            "first_step": {
              "type": "null"
            },
            "vectorized": {
              "const": false
            },
            "dense_output": {
              "const": false
            },
            "events": {
              "type": "null"
            },
            "jacobian": {
              "enum": [
                "constant_exact",
                "not_supplied"
              ]
            }
          },
          "required": [
            "first_step",
            "vectorized",
            "dense_output",
            "events",
            "jacobian"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "method",
        "options"
      ],
      "additionalProperties": false
    },
    "evaluations": {
      "type": "object",
      "properties": {
        "nfev": {
          "type": "integer",
          "minimum": 0
        },
        "njev": {
          "type": "integer",
          "minimum": 0
        },
        "nlu": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "nfev",
        "njev",
        "nlu"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "python_implementation": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "fenix_bio_version": {
          "type": "string",
          "minLength": 1
        },
        "rfc8785_version": {
          "type": "string",
          "minLength": 1
        },
        "numpy_version": {
          "type": "string",
          "minLength": 1
        },
        "scipy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "python_implementation",
        "python_version",
        "fenix_bio_version",
        "rfc8785_version",
        "numpy_version",
        "scipy_version"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "started_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
          "minLength": 27,
          "maxLength": 27
        },
        "finished_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
          "minLength": 27,
          "maxLength": 27
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "started_at_utc",
        "finished_at_utc",
        "elapsed_seconds"
      ],
      "additionalProperties": false
    },
    "integration": {
      "enum": [
        "performed",
        "skipped_zero_grid"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "media_type": {
          "const": "application/json"
        },
        "encoding": {
          "const": "utf-8"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "schema_version",
        "media_type",
        "encoding",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schema_version",
    "status",
    "repeatability",
    "sources",
    "fir",
    "execution",
    "randomness",
    "solver",
    "evaluations",
    "environment",
    "timing",
    "integration",
    "output"
  ],
  "additionalProperties": false,
  "definitions": {
    "source": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 64,
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "schema_version",
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    }
  }
}
