            },
            "receiver.signal": {
              "$ref": "#/definitions/id"
            },
            "env.signal": {
              "$ref": "#/definitions/id"
            },
            "receiver.reporter": {
              "$ref": "#/definitions/id"
            }
          },
          "required": [
            "sender.signal",
            "receiver.signal",
            "env.signal",
            "receiver.reporter"
          ],
          "additionalProperties": false
        }
