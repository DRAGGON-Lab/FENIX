                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "L"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "receiver": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "L"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "env": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "L"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "sender",
            "receiver",
            "env"
          ],
          "additionalProperties": false
