    "model": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.2.0"
        },
        "template": {
          "const": "community.exchange.hill.v1"
        },
        "time_unit": {
          "const": "s"
        },
        "volumes": {
          "type": "object",
          "properties": {
            "sender": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
