        "populations": {
          "$ref": "#/definitions/populations"
        },
        "initial_counts": {
          "$ref": "#/definitions/counts"
        },
        "parameters": {
          "$ref": "#/definitions/rates"
        },
        "observables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "state": {
                "enum": [
                  "sender.signal",
                  "receiver.signal",
                  "env.signal",
                  "receiver.reporter"
                ]
              }
            },
            "required": [
              "id",
              "state"
            ],
            "additionalProperties": false
          }
        },
        "capabilities": {
          "const": {
            "ode": true,
            "ssa": false
          }
        }
      },
      "required": [
        "schema_version",
        "template",
        "time_unit",
        "volumes",
        "populations",
        "initial_counts",
        "parameters",
