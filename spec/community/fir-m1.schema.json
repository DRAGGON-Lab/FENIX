    "provenance": {
      "type": "object",
      "properties": {
        "design_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "experiment_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "owners": {
          "type": "object",
          "properties": {
            "sender": {
              "$ref": "#/definitions/id"
            },
            "receiver": {
              "$ref": "#/definitions/id"
            },
            "env": {
              "$ref": "#/definitions/id"
            }
          },
          "required": [
            "sender",
            "receiver",
            "env"
          ],
          "additionalProperties": false
        },
        "species": {
          "type": "object",
          "properties": {
            "sender.signal": {
              "$ref": "#/definitions/id"
            },
            "receiver.signal": {
              "$ref": "#/definitions/id"
            },
            "env.signal": {
              "$ref": "#/definitions/id"
            },
            "receiver.reporter": {
              "$ref": "#/definitions/id"
            }
          },
          "required": [
            "sender.signal",
            "receiver.signal",
            "env.signal",
            "receiver.reporter"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "design_digest",
        "experiment_digest",
        "owners",
        "species"
      ],
