            "env": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "L"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
