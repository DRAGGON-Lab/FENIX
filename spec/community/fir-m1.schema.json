                "unit": {
                  "const": "L"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "receiver": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
