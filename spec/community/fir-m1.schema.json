        "populations": {
          "$ref": "#/definitions/populations"
        },
        "initial_counts": {
          "$ref": "#/definitions/counts"
        },
        "parameters": {
          "$ref": "#/definitions/rates"
        },
        "observables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "state": {
                "enum": [
                  "sender.signal",
                  "receiver.signal",
                  "env.signal",
                  "receiver.reporter"
                ]
              }
            },
            "required": [
              "id",
              "state"
            ],
            "additionalProperties": false
          }
        },
        "capabilities": {
          "const": {
            "ode": true,
            "ssa": false
          }
        },
        "reactions": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              {
                "id": "sender.export",
                "flux": {
                  "op": "multiply",
                  "left": {
                    "op": "parameter",
                    "id": "sender_export"
                  },
                  "right": {
                    "op": "state",
                    "id": "sender.signal"
                  }
                },
                "stoichiometry": {
                  "sender.signal": -1,
                  "env.signal": {
                    "op": "population",
                    "id": "sender"
                  }
                }
              },
              {
                "id": "sender.import",
                "flux": {
                  "op": "multiply",
                  "left": {
                    "op": "parameter",
                    "id": "sender_import"
                  },
                  "right": {
                    "op": "multiply",
                    "left": {
                      "op": "volume",
                      "id": "sender"
                    },
                    "right": {
                      "op": "divide",
                      "left": {
                        "op": "state",
                        "id": "env.signal"
                      },
                      "right": {
                        "op": "volume",
                        "id": "env"
                      }
                    }
                  }
                },
                "stoichiometry": {
                  "sender.signal": 1,
                  "env.signal": {
                    "op": "negate",
                    "value": {
                      "op": "population",
                      "id": "sender"
                    }
                  }
                }
              },
              {
                "id": "sender.decay",
                "flux": {
                  "op": "multiply",
                  "left": {
                    "op": "parameter",
                    "id": "sender_decay"
                  },
                  "right": {
                    "op": "state",
                    "id": "sender.signal"
                  }
                },
                "stoichiometry": {
                  "sender.signal": -1
                }
              },
              {
                "id": "receiver.export",
                "flux": {
                  "op": "multiply",
                  "left": {
                    "op": "parameter",
                    "id": "receiver_export"
                  },
                  "right": {
                    "op": "state",
                    "id": "receiver.signal"
                  }
                },
                "stoichiometry": {
                  "receiver.signal": -1,
                  "env.signal": {
                    "op": "population",
                    "id": "receiver"
                  }
                }
              },
              {
                "id": "receiver.import",
                "flux": {
                  "op": "multiply",
                  "left": {
                    "op": "parameter",
                    "id": "receiver_import"
                  },
                  "right": {
                    "op": "multiply",
                    "left": {
                      "op": "volume",
                      "id": "receiver"
                    },
                    "right": {
                      "op": "divide",
                      "left": {
                        "op": "state",
                        "id": "env.signal"
                      },
                      "right": {
                        "op": "volume",
                        "id": "env"
                      }
                    }
                  }
                },
                "stoichiometry": {
                  "receiver.signal": 1,
                  "env.signal": {
                    "op": "negate",
                    "value": {
                      "op": "population",
                      "id": "receiver"
                    }
                  }
                }
              },
              {
                "id": "receiver.decay",
                "flux": {
                  "op": "multiply",
                  "left": {
                    "op": "parameter",
                    "id": "receiver_decay"
                  },
                  "right": {
                    "op": "state",
                    "id": "receiver.signal"
                  }
                },
                "stoichiometry": {
                  "receiver.signal": -1
                }
              },
              {
                "id": "sender.production",
                "flux": {
                  "op": "parameter",
                  "id": "sender_production"
                },
                "stoichiometry": {
                  "sender.signal": 1
                }
              },
              {
                "id": "env.decay",
                "flux": {
                  "op": "multiply",
                  "left": {
                    "op": "parameter",
                    "id": "env_decay"
                  },
                  "right": {
                    "op": "state",
                    "id": "env.signal"
                  }
                },
                "stoichiometry": {
                  "env.signal": -1
                }
              },
              {
                "id": "reporter.production",
                "flux": {
                  "op": "add",
                  "left": {
                    "op": "parameter",
                    "id": "reporter_basal"
                  },
                  "right": {
                    "op": "multiply",
                    "left": {
                      "op": "parameter",
                      "id": "reporter_induced"
                    },
                    "right": {
                      "op": "hill",
                      "density": {
                        "op": "divide",
                        "left": {
                          "op": "state",
                          "id": "env.signal"
                        },
                        "right": {
                          "op": "volume",
                          "id": "env"
                        }
                      },
                      "threshold": {
                        "op": "parameter",
                        "id": "threshold"
                      },
                      "exponent": {
                        "op": "parameter",
                        "id": "hill_n"
                      }
                    }
                  }
                },
                "stoichiometry": {
                  "receiver.reporter": 1
                }
              },
              {
                "id": "reporter.decay",
                "flux": {
                  "op": "multiply",
                  "left": {
                    "op": "parameter",
                    "id": "reporter_decay"
                  },
                  "right": {
                    "op": "state",
                    "id": "receiver.reporter"
                  }
                },
                "stoichiometry": {
                  "receiver.reporter": -1
                }
              }
            ]
          }
        },
        "equations": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              {
                "state": "sender.signal",
                "unit": "molecule/s",
                "rhs": {
                  "op": "add",
                  "left": {
                    "op": "subtract",
                    "left": {
                      "op": "subtract",
                      "left": {
                        "op": "flux",
                        "id": "sender.import"
                      },
                      "right": {
                        "op": "flux",
                        "id": "sender.export"
                      }
                    },
                    "right": {
                      "op": "flux",
                      "id": "sender.decay"
                    }
                  },
                  "right": {
                    "op": "flux",
                    "id": "sender.production"
                  }
                }
              },
              {
                "state": "receiver.signal",
                "unit": "molecule/s",
                "rhs": {
                  "op": "subtract",
                  "left": {
                    "op": "subtract",
                    "left": {
                      "op": "flux",
                      "id": "receiver.import"
                    },
                    "right": {
                      "op": "flux",
                      "id": "receiver.export"
                    }
                  },
                  "right": {
                    "op": "flux",
                    "id": "receiver.decay"
                  }
                }
              },
              {
                "state": "env.signal",
                "unit": "molecule/s",
                "rhs": {
                  "op": "subtract",
                  "left": {
                    "op": "add",
                    "left": {
                      "op": "multiply",
                      "left": {
                        "op": "population",
                        "id": "sender"
                      },
                      "right": {
                        "op": "subtract",
                        "left": {
                          "op": "flux",
                          "id": "sender.export"
                        },
                        "right": {
                          "op": "flux",
                          "id": "sender.import"
                        }
                      }
                    },
                    "right": {
                      "op": "multiply",
                      "left": {
                        "op": "population",
                        "id": "receiver"
                      },
                      "right": {
                        "op": "subtract",
                        "left": {
                          "op": "flux",
                          "id": "receiver.export"
                        },
                        "right": {
                          "op": "flux",
                          "id": "receiver.import"
                        }
                      }
                    }
                  },
                  "right": {
                    "op": "flux",
                    "id": "env.decay"
                  }
                }
              },
              {
                "state": "receiver.reporter",
                "unit": "molecule/s",
                "rhs": {
                  "op": "subtract",
                  "left": {
                    "op": "flux",
                    "id": "reporter.production"
                  },
                  "right": {
                    "op": "flux",
                    "id": "reporter.decay"
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "template",
        "time_unit",
        "volumes",
        "populations",
        "initial_counts",
        "parameters",
        "observables",
        "capabilities",
        "reactions",
        "equations"
      ],
      "additionalProperties": false
