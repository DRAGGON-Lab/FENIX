{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate production-decay reference catalog (not FIR)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "status", "contract", "units", "cases"],
  "properties": {
    "format": {"const": "production-decay-catalog-v1"},
    "status": {"const": "REVIEW_REQUIRED"},
    "contract": {"const": "spec/fir/proposals/ADR-P02.md"},
    "units": {"const": {"alpha": "molecule/s", "beta": "1/s", "x0": "molecule", "time": "s", "expected": "molecule"}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "bits": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "expected": {"type": "string", "pattern": "^(0|[1-9]\\.[0-9]{49}E[+-][0-9]{1,4})$"},
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rationale", "parameters", "samples"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "rationale": {"type": "string", "minLength": 1},
        "parameters": {
          "type": "object", "additionalProperties": false,
          "required": ["alpha", "beta", "x0"],
          "properties": {"alpha": {"$ref": "#/$defs/bits"}, "beta": {"$ref": "#/$defs/bits"}, "x0": {"$ref": "#/$defs/bits"}}
        },
        "samples": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["time_bits", "expected"],
            "properties": {"time_bits": {"$ref": "#/$defs/bits"}, "expected": {"$ref": "#/$defs/expected"}}
          }
        }
      }
    }
  }
}
