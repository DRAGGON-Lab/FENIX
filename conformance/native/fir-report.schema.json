{
  "type": "object",
  "properties": {
    "report_version": {
      "type": "integer",
      "const": 1
    },
    "implementation": {
      "enum": [
        "python",
        "julia"
      ]
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "CPython",
            "Julia"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "name",
        "version",
        "os",
        "arch",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "fingerprints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 300,
      "maxItems": 300,
      "items": {
        "type": "object",
        "properties": {
          "catalog": {
            "enum": [
              "canonicalization",
              "rejections",
              "producer"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minProperties": 1
          },
          "observed": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "accept"
                  }
                },
                "required": [
                  "outcome"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "reject"
                  }
                },
                "required": [
                  "outcome"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "reject"
                  },
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string"
                  },
                  "document": {
                    "enum": [
                      "primary",
                      "design",
                      "experiment",
                      "previous",
                      "request"
                    ]
                  }
                },
                "required": [
                  "outcome",
                  "category",
                  "path",
                  "document"
                ],
                "additionalProperties": false
              }
            ]
          },
          "artifacts": {
            "type": "object",
            "properties": {
              "canonical": {
                "type": "object",
                "properties": {
                  "hex": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{2})*$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "hex",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "model": {
                "type": "object",
                "properties": {
                  "hex": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{2})*$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "hex",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "identity": {
                "type": "object",
                "properties": {
                  "hex": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{2})*$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "hex",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "catalog",
          "id",
          "sources",
          "observed",
          "artifacts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "report_version",
    "implementation",
    "source_revision",
    "runtime",
    "fingerprints",
    "cases"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FENIX native FIR test report v1 (non-normative evidence)"
}
