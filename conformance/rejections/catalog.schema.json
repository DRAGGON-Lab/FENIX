{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "catalog_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "REVIEW_REQUIRED"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "operation": {
            "enum": [
              "parse",
              "design",
              "experiment",
              "revision",
              "model",
              "producer",
              "capability"
            ]
          },
          "contract": {
            "enum": [
              "P01",
              "P03"
            ]
          },
          "inputs": {
            "type": "object",
            "properties": {
              "primary": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(conformance|spec)/[^\\\\]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "design": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(conformance|spec)/[^\\\\]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "experiment": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(conformance|spec)/[^\\\\]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "previous": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(conformance|spec)/[^\\\\]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "request": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(conformance|spec)/[^\\\\]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "primary"
            ],
            "additionalProperties": false
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "accept"
                  }
                },
                "required": [
                  "outcome"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "reject"
                  },
                  "stage": {
                    "enum": [
                      "parse",
                      "structure",
                      "semantic",
                      "producer",
                      "capability"
                    ]
                  },
                  "category": {
                    "type": "string",
                    "pattern": "^[A-Z_]+$"
                  },
                  "document": {
                    "enum": [
                      "primary",
                      "design",
                      "experiment",
                      "previous",
                      "request"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(|/([^~]|~[01])*)$"
                  }
                },
                "required": [
                  "outcome",
                  "stage",
                  "category",
                  "document",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "operation",
          "contract",
          "inputs",
          "expected",
          "reference"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "duplicate-ids-keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "broken-revision-digest": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "invalid-unit": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "missing-port-reference": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "unsupported-profile": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "invalid-event": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "p03-contract-only": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "p02-examples": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "positive-controls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "numeric-policy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "duplicate-ids-keys",
        "broken-revision-digest",
        "invalid-unit",
        "missing-port-reference",
        "unsupported-profile",
        "invalid-event",
        "p03-contract-only",
        "p02-examples",
        "positive-controls",
        "numeric-policy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "catalog_version",
    "status",
    "cases",
    "coverage"
  ],
  "additionalProperties": false
}
